+++ b/tests/integration-tests/src/test_tm06_sponsored_plan_rent_refund.rs
@@ -0,0 +1,121 @@
+use solana_instruction::{AccountMeta, Instruction};
+use solana_pubkey::Pubkey;
+use solana_signer::Signer;
+
+use crate::{
+    instructions::create_plan::{PlanData, PlanTerms, MAX_DESTINATIONS, MAX_PULLERS},
+    state::plan::Plan,
+    tests::{
+        asserts::TransactionResultExt,
+        constants::{MINT_DECIMALS, PROGRAM_ID, SYSTEM_PROGRAM_ID, TOKEN_PROGRAM_ID},
+        pda::get_plan_pda,
+        utils::{
+            build_and_send_transaction, current_ts, days, init_mint, init_wallet, move_clock_forward, setup,
+            DeletePlan,
+        },
+    },
+};
+
+const RENT_SPONSOR_FUNDING: u64 = 10_000_000_000;
+const MAX_CREATE_SIGNATURE_FEE: u64 = 10_000;
+const MAX_DELETE_SIGNATURE_FEE: u64 = 10_000;
+
+/// Exercises the complete sponsored-Plan lifecycle against the pinned Program.
+///
+/// Merchant is the transaction fee payer for both operations. Sponsor is only
+/// the optional instruction-level CreatePlan rent payer. DeletePlan must return
+/// the entire Plan account balance to Merchant, never to Sponsor.
+#[test]
+fn sponsored_plan_rent_is_refunded_to_merchant_on_delete_not_sponsor() {
+    let (litesvm, merchant) = &mut setup();
+    let sponsor = init_wallet(litesvm, RENT_SPONSOR_FUNDING);
+    let mint = init_mint(litesvm, TOKEN_PROGRAM_ID, MINT_DECIMALS, 1_000_000_000, None, &[]);
+    let destination = Pubkey::new_unique();
+    let plan_id = 91;
+    let end_ts = current_ts() + days(2) as i64;
+
+    let merchant_before_create = litesvm.get_account(&merchant.pubkey()).unwrap().lamports;
+    let sponsor_before_create = litesvm.get_account(&sponsor.pubkey()).unwrap().lamports;
+    let (plan_pda, _) = get_plan_pda(&merchant.pubkey(), plan_id);
+
+    let zero_addr: pinocchio::Address = [0u8; 32].into();
+    let mut destinations = [zero_addr; MAX_DESTINATIONS];
+    destinations[0] = destination.to_bytes().into();
+
+    let plan_data = PlanData {
+        plan_id,
+        mint: mint.to_bytes().into(),
+        terms: PlanTerms { amount: 1_000, period_hours: 24, created_at: 0 },
+        end_ts,
+        destinations,
+        pullers: [zero_addr; MAX_PULLERS],
+        metadata_uri: [0u8; 128],
+    };
+    let plan_data_bytes =
+        unsafe { std::slice::from_raw_parts(&plan_data as *const PlanData as *const u8, PlanData::LEN) };
+    let mut instruction_data = vec![*crate::instructions::create_plan::DISCRIMINATOR];
+    instruction_data.extend_from_slice(plan_data_bytes);
+
+    let create_ix = Instruction {
+        program_id: PROGRAM_ID,
+        accounts: vec![
+            AccountMeta::new(merchant.pubkey(), true),
+            AccountMeta::new(plan_pda, false),
+            AccountMeta::new_readonly(mint, false),
+            AccountMeta::new_readonly(SYSTEM_PROGRAM_ID, false),
+            AccountMeta::new_readonly(TOKEN_PROGRAM_ID, false),
+            AccountMeta::new(sponsor.pubkey(), true),
+        ],
+        data: instruction_data,
+    };
+
+    // Crucial separation: Merchant pays the transaction fee; Sponsor pays only
+    // the Plan account's instruction-level Rent through the optional payer meta.
+    build_and_send_transaction(litesvm, &[merchant, &sponsor], &merchant.pubkey(), &create_ix).assert_ok();
+
+    let plan_account = litesvm.get_account(&plan_pda).expect("sponsored Plan PDA must exist");
+    let plan_rent_lamports = plan_account.lamports;
+    assert!(plan_rent_lamports > MAX_CREATE_SIGNATURE_FEE);
+    let plan = Plan::load(&plan_account.data).unwrap();
+    let plan_owner = plan.owner;
+    assert_eq!(plan_owner.to_bytes(), merchant.pubkey().to_bytes());
+
+    let merchant_after_create = litesvm.get_account(&merchant.pubkey()).unwrap().lamports;
+    let sponsor_after_create = litesvm.get_account(&sponsor.pubkey()).unwrap().lamports;
+    assert!(merchant_before_create >= merchant_after_create);
+    assert!(
+        merchant_before_create - merchant_after_create <= MAX_CREATE_SIGNATURE_FEE,
+        "Merchant must pay only its transaction signature fee, not Plan Rent"
+    );
+    assert!(sponsor_before_create >= sponsor_after_create);
+    assert_eq!(
+        sponsor_before_create - sponsor_after_create,
+        plan_rent_lamports,
+        "Sponsor must fund exactly the Plan account Rent and no transaction fee"
+    );
+
+    // DeletePlan requires a finite Plan whose end timestamp is in the past.
+    move_clock_forward(litesvm, days(3));
+
+    let merchant_before_delete = litesvm.get_account(&merchant.pubkey()).unwrap().lamports;
+    let sponsor_before_delete = litesvm.get_account(&sponsor.pubkey()).unwrap().lamports;
+    DeletePlan::new(litesvm, merchant, plan_pda).execute().assert_ok();
+
+    let account_after_delete = litesvm.get_account(&plan_pda);
+    assert!(
+        account_after_delete.is_none()
+            || account_after_delete.as_ref().map(|account| account.lamports).unwrap_or(0) == 0,
+        "Plan PDA must be closed after successful DeletePlan"
+    );
+
+    let merchant_after_delete = litesvm.get_account(&merchant.pubkey()).unwrap().lamports;
+    let sponsor_after_delete = litesvm.get_account(&sponsor.pubkey()).unwrap().lamports;
+    assert!(
+        merchant_after_delete >= merchant_before_delete + plan_rent_lamports - MAX_DELETE_SIGNATURE_FEE,
+        "Merchant must receive the Plan Rent back, less only its own transaction fee"
+    );
+    assert_eq!(
+        sponsor_after_delete, sponsor_before_delete,
+        "Sponsor must not receive any refund when the Merchant deletes its Plan"
+    );
+}
