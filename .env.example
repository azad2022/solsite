# Runtime
NODE_ENV=production
PORT=3000
APP_URL=https://solmint.ir

# Gemini
# Required only for Gemini-powered server features.
GEMINI_API_KEY=

# Supabase
# Public client configuration. These must NOT contain a service-role key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_URL=https://nvopkbiedorfshwbmyhn.supabase.co

# SERVER-ONLY Supabase credential used by the trusted Express server.
# NEVER prefix this with VITE_ and NEVER expose it to browser code.
SUPABASE_SERVICE_ROLE_KEY=

# GitHub media storage (server-side only)
GITHUB_TOKEN=
GITHUB_MEDIA_TOKEN=

# Admin authentication
# REQUIRED in production. Never use a default/shared password.
ADMIN_PASSCODE=

# Automated publishing
# REQUIRED if the external scheduler endpoint is enabled.
AUTOPUBLISH_CRON_SECRET=

# DeepSeek (server-side only)
DEEPSEEK_API_KEY=

# SolMint Pay — SERVER ONLY. The Pay API remains disabled until release gates pass.
PAY_API_ENABLED=false
PAY_APP_ORIGIN=https://solmint.ir
PAY_FEE_RECIPIENT=
PAY_USDC_MINT=
PAY_USDC_DECIMALS=6
PAY_USDT_MINT=
PAY_USDT_DECIMALS=6
PAY_DEFAULT_EXPIRY_SECONDS=900

# Blockchain observer — server/worker only.
# Use a dedicated RPC endpoint with rate limits appropriate for production.
SOLANA_RPC_URL=
# REQUIRED for the private reconciliation endpoint. Use a high-entropy random secret.
PAY_RECONCILE_SECRET=
PAY_RECONCILE_BATCH_SIZE=10

# Optional: disable Vite HMR/file watching in development environments that need it.
DISABLE_HMR=false
