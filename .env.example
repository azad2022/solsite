# Runtime
NODE_ENV=production
PORT=3000
APP_URL=https://solmint.ir

# Gemini
# Required only for Gemini-powered server features.
GEMINI_API_KEY=

# Supabase
# Public client configuration. These must NOT contain a service-role key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_URL=https://nvopkbiedorfshwbmyhn.supabase.co

# SERVER-ONLY Supabase credential used by the trusted Express/server functions.
# NEVER prefix this with VITE_ and NEVER expose it to browser code.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_SECRET_KEY=

# SolMint Pay internal Better Auth -> PostgREST RLS bridge (server-only).
# The private key must be the PKCS#8 private key corresponding to a signing key
# trusted by this Supabase project's JWT verifier. Never commit or expose it.
SUPABASE_INTERNAL_JWT_PRIVATE_KEY=
# Explicit asymmetric algorithm: ES256 or RS256.
SUPABASE_INTERNAL_JWT_ALGORITHM=
# Exact signing-key kid trusted by the live Supabase project.
SUPABASE_INTERNAL_JWT_KEY_ID=
# Exact JWT issuer accepted by the live Supabase project.
SUPABASE_INTERNAL_JWT_ISSUER=
# Exact JWT audience accepted by the live Supabase project.
SUPABASE_INTERNAL_JWT_AUDIENCE=
# Optional; 60 seconds by default and restricted by runtime to 30..300 seconds.
SUPABASE_INTERNAL_JWT_TTL_SECONDS=60
# Optional project API key used with the internal bearer token. When omitted,
# the server falls back to SUPABASE_SECRET_KEY.
SUPABASE_PUBLISHABLE_KEY=

# GitHub media storage (server-side only)
GITHUB_TOKEN=
GITHUB_MEDIA_TOKEN=

# Admin authentication
# REQUIRED in production. Never use a default/shared password.
ADMIN_PASSCODE=

# Automated publishing
# REQUIRED if the external scheduler endpoint is enabled.
AUTOPUBLISH_CRON_SECRET=

# DeepSeek (server-side only)
DEEPSEEK_API_KEY=

# Optional: disable Vite HMR/file watching in development environments that need it.
DISABLE_HMR=false
