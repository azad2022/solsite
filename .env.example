# Runtime
NODE_ENV=production
PORT=3000
APP_URL=https://solmint.ir

# Gemini
# Required only for Gemini-powered server features.
GEMINI_API_KEY=

# Supabase
# Public client configuration. These must NOT contain a service-role key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_URL=https://nvopkbiedorfshwbmyhn.supabase.co

# SERVER-ONLY Supabase credential used by the trusted Express server.
# NEVER prefix this with VITE_ and NEVER expose it to browser code.
SUPABASE_SERVICE_ROLE_KEY=

# SolMint Pay — blockchain RPC (SERVER-ONLY)
# Production uses a dedicated Helius Mainnet RPC endpoint.
# Do NOT use the VITE_ prefix. Do NOT expose this to browser code.
# Do NOT commit a real API key. Configure the final value as a deployment secret.
SOLANA_RPC_URL=

# Pay runtime defaults (server-side only)
# Keep Pay disabled until all production release gates pass.
PAY_API_ENABLED=false
PAY_FEE_RECIPIENT=
PAY_USDC_MINT=
PAY_USDC_DECIMALS=
PAY_USDT_MINT=
PAY_USDT_DECIMALS=
PAY_DEFAULT_EXPIRY_SECONDS=900

# Internal Pay workers (server-side only)
PAY_RECONCILE_SECRET=
PAY_WEBHOOK_WORKER_SECRET=
WEBHOOK_MASTER_KEY=

# Dedicated webhook egress gateway (server-side only)
# Must be an HTTPS origin-side endpoint separate from the Pages/Worker hostname.
# The endpoint validates DNS answers, rejects non-public destinations, then connects to the resolved IP directly.
PAY_WEBHOOK_EGRESS_URL=
PAY_WEBHOOK_EGRESS_SECRET=
PAY_WEBHOOK_EGRESS_PORT=8788

# GitHub media storage (server-side only)
GITHUB_TOKEN=
GITHUB_MEDIA_TOKEN=

# Admin authentication
# REQUIRED in production. Never use a default/shared password.
ADMIN_PASSCODE=

# Automated publishing
# REQUIRED if the external scheduler endpoint is enabled.
AUTOPUBLISH_CRON_SECRET=

# DeepSeek (server-side only)
DEEPSEEK_API_KEY=

# Optional: disable Vite HMR/file watching in development environments that need it.
DISABLE_HMR=false
