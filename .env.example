# Runtime
NODE_ENV=production
PORT=3000
APP_URL=https://solmint.ir

# Gemini
# Required only for Gemini-powered server features.
GEMINI_API_KEY=

# Supabase
# Public client configuration. These must NOT contain a service-role key.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_URL=https://nvopkbiedorfshwbmyhn.supabase.co

# SERVER-ONLY Supabase credential used by the trusted Express server.
# NEVER prefix this with VITE_ and NEVER expose it to browser code.
SUPABASE_SERVICE_ROLE_KEY=

# Pay internal authorization bridge (SERVER-ONLY).
# The private key is a PKCS#8 PEM for the asymmetric signing key trusted by Supabase.
# Do not commit this value, expose it to Vite, put it in URLs, or log it.
# Algorithm/key-id/issuer/audience MUST match the live Supabase signing-key configuration.
SUPABASE_INTERNAL_JWT_PRIVATE_KEY=
SUPABASE_INTERNAL_JWT_ALGORITHM=
SUPABASE_INTERNAL_JWT_KEY_ID=
SUPABASE_INTERNAL_JWT_ISSUER=
SUPABASE_INTERNAL_JWT_AUDIENCE=
# Optional; defaults to 60 seconds and is hard-limited to 30..300 seconds.
SUPABASE_INTERNAL_JWT_TTL_SECONDS=60

# GitHub media storage (server-side only)
GITHUB_TOKEN=
GITHUB_MEDIA_TOKEN=

# Admin authentication
# REQUIRED in production. Never use a default/shared password.
ADMIN_PASSCODE=

# Automated publishing
# REQUIRED if the external scheduler endpoint is enabled.
AUTOPUBLISH_CRON_SECRET=

# DeepSeek (server-side only)
DEEPSEEK_API_KEY=

# Optional: disable Vite HMR/file watching in development environments that need it.
DISABLE_HMR=false
