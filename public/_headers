# Global security headers for the static Cloudflare Pages responses.
# Pages Functions responses must set equivalent headers in the function Response.
/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; script-src 'self' 'unsafe-inline' https:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; connect-src 'self' https: wss:; frame-src 'self' https:; worker-src 'self' blob:; manifest-src 'self'; upgrade-insecure-requests

# Homepage HTML: short edge/browser caching plus machine-readable API/agent discovery links.
/
  Cache-Control: public, max-age=60, s-maxage=300, stale-while-revalidate=3600
  Link: </.well-known/api-catalog>; rel="api-catalog", </openapi.json>; rel="service-desc"; type="application/vnd.oai.openapi+json;version=3.1", </api-docs/>; rel="service-doc"; type="text/html", </api-docs/>; rel="describedby"; type="text/html"

# RFC 9727 API Catalog: explicit Linkset media type for the static fallback.
/.well-known/api-catalog
  Content-Type: application/linkset+json; profile="https://www.rfc-editor.org/info/rfc9727"
  Cache-Control: public, max-age=300, s-maxage=3600, stale-while-revalidate=86400
  X-Content-Type-Options: nosniff
  Link: </.well-known/api-catalog>; rel="api-catalog"

# Agent authentication discovery document.
/auth.md
  Content-Type: text/markdown; charset=utf-8
  Cache-Control: public, max-age=300, s-maxage=3600, stale-while-revalidate=86400
  X-Content-Type-Options: nosniff

# Fingerprinted Vite assets can be cached for a year safely.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
