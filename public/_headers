# Global security headers for the static Cloudflare Pages responses.
# Pages Functions responses must set equivalent headers in the function Response.
/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Cross-Origin-Opener-Policy: same-origin-allow-popups
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=()
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; script-src 'self' 'unsafe-inline' https:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; connect-src 'self' https: wss:; frame-src 'self' https:; worker-src 'self' blob:; manifest-src 'self'; upgrade-insecure-requests

# Homepage HTML: short edge/browser caching; content is refreshed by deployments.
/
  Cache-Control: public, max-age=60, s-maxage=300, stale-while-revalidate=3600

# Fingerprinted Vite assets can be cached for a year safely.
/assets/*
  Cache-Control: public, max-age=31536000, immutable
